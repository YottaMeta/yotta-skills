{
  "manifestVersion": 1,
  "slug": "yotta-skills",
  "name": "元阁",
  "package": "@yottameta/yotta-skills",
  "version": "0.19.1",
  "trust": "yottameta",
  "install": {
    "idempotent": true
  },
  "permissions": {
    "filesystem": "user-skills-dir",
    "network": "registry",
    "process": "child-process",
    "note": "安装器按用户指定 registry 下载技能包；安装前执行元信门禁与 hook 评估。"
  },
  "auto_apply": {
    "mode": "hook",
    "note": "元阁自身作为安装 wrapper，声明落位前安装门禁。"
  },
  "hooks": [
    {
      "event": "before_install",
      "require_tool": "install_gate",
      "condition": "安装或升级动作进入落位前",
      "on_fail": "block",
      "fallback": "wrapper",
      "evidence": [
        "audit_log",
        "exit_code"
      ]
    }
  ]
}
